}

/* 2-Column Split: Sticky Anchor + Straight Vertical Track */
.timeline-straight-container {
  display: grid;
  grid-template-columns: 380px 1fr;
  gap: 64px;
  margin-top: 60px;
  align-items: flex-start;
}

/* Left Column: Sticky Studio Anchor Card */
.timeline-story-anchor {
  position: sticky;
  top: 120px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.timeline-img-card-v {
  position: relative;
  width: 100%;
  height: 250px;
  border-radius: 18px;
  overflow: hidden;
  border: 1px solid rgba(212, 175, 55, 0.35);
  box-shadow: 0 16px 45px rgba(0, 0, 0, 0.8), 0 0 25px rgba(212, 175, 55, 0.15);
  background: #0a0a0c;
}

.timeline-img-cover-v {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.9) contrast(1.1);
  transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.timeline-img-card-v:hover .timeline-img-cover-v {
  transform: scale(1.05);
}

.timeline-img-overlay-v {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(5, 5, 5, 0.94) 0%, rgba(5, 5, 5, 0.25) 60%, transparent 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 22px;
}

.timeline-img-badge-v {
  display: inline-block;
  align-self: flex-start;
  font-family: var(--font-heading);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--gold-bright, #F4D36B);
  background: rgba(0, 0, 0, 0.65);
  border: 1px solid rgba(212, 175, 55, 0.4);
  padding: 4px 12px;
  border-radius: 999px;
  margin-bottom: 8px;
  backdrop-filter: blur(8px);
}

.timeline-img-caption-v {
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.01em;
}

.story-anchor-meta {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.story-anchor-period {
  font-family: var(--font-heading);
  font-size: 14px;
  font-weight: 800;
  color: var(--gold-bright, #F4D36B);
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.story-anchor-title {
  font-family: var(--font-heading);
  font-size: 26px;
  font-weight: 800;
  line-height: 1.15;
  color: #ffffff;
}

.story-anchor-desc {
  font-size: 14px;
  color: #a1a1aa;
