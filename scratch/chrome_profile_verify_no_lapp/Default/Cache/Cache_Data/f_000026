/* ==========================================================================
   EVOLUTE — THE FUTURE OF THINKING
   Ultra-Premium Modern Aesthetic Design System & Recreated Layout
   ========================================================================== */

:root {
  /* Riyadvi Official Brand Palette (Dark + Luxury + 3D + Gold) */
  --bg-deep: #050505;              /* #050505 — Primary Black */
  --bg-surface: #0a0a0a;           /* #0A0A0A — Secondary Background */
  --bg-surface-elevated: #111111;  /* #111111 — Surface */
  --bg-card: rgba(17, 17, 17, 0.85);
  --bg-card-elevated: #171717;     /* #171717 — Elevated Surface */
  --bg-card-border: rgba(212, 175, 55, 0.16);
  --bg-card-hover: rgba(23, 23, 23, 0.95);

  /* Riyadvi Gold Hierarchy */
  --gold-primary: #D4AF37;         /* #D4AF37 — Gold */
  --gold-bright: #F4D36B;          /* #F4D36B — Bright Gold */
  --gold-champagne: #E8C875;       /* #E8C875 — Champagne */
  --gold-glow: rgba(212, 175, 55, 0.5);
  --gold-ambient: rgba(212, 175, 55, 0.14);

  /* Amber compatibility mapped to Metallic Gold */
  --amber-core: #D4AF37;
  --amber-glow: rgba(212, 175, 55, 0.55);
  --amber-ambient: rgba(212, 175, 55, 0.14);
  --cyan-subtle: #38bdf8;
  
  /* Text Accents */
  --text-primary: #FFFFFF;         /* #FFFFFF — White */
  --text-secondary: #A8A8A8;       /* #A8A8A8 — Secondary Text */
  --text-muted: #9da0a6;
  --text-dim: #64646e;
  --text-faint: rgba(255, 255, 255, 0.14);

  /* Typography */
  --font-heading: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-sans: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;

  /* Transitions & Depth */
  --transition-smooth: cubic-bezier(0.16, 1, 0.3, 1);
  --card-radius: 6px;
}

/* Global Reset */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: auto;
  background-color: var(--bg-deep);
  color: var(--text-primary);
  font-family: var(--font-body);
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: clip;
}

html.lenis, html.lenis body {
  height: auto;
}

.lenis.lenis-smooth {
  scroll-behavior: auto !important;
}

.lenis.lenis-smooth [data-lenis-prevent] {
  overscroll-behavior: contain;
}

.lenis.lenis-stopped {
  overflow: hidden;
}

.lenis.lenis-smooth iframe {
  pointer-events: none;
}

body {
  background-color: var(--bg-deep);
  color: var(--text-primary);
  min-height: 100vh;
  overflow-x: clip;
  position: relative;
}

/* Background Atmospheric Overlays */
.ambient-glow {
  position: fixed;
  top: 25%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 65vw;
  height: 55vh;
  background: radial-gradient(circle at center, var(--amber-ambient) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
  filter: blur(80px);
}

.subtle-grid-bg {
  position: fixed;
  inset: 0;
  background-image: 
    linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
  background-size: 80px 80px;
  background-position: center top;
  pointer-events: none;
  z-index: 0;
}

/* ==========================================================================
   NAVIGATION BAR & BRANDING
   ========================================================================== */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  padding: 24px clamp(24px, 5.5vw, 72px);
  background: transparent;
  transition: padding 0.35s ease, background 0.35s ease, backdrop-filter 0.35s ease, transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
}

.navbar.scrolled {
  padding: 12px clamp(24px, 5.5vw, 72px);
  background: rgba(5, 5, 5, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(212, 175, 55, 0.18);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
}

.navbar.nav-hidden {
  transform: translateY(-100%);
}

.nav-container {
  max-width: 1440px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* Brand Logo with Official Riyadvi Emblem */
.logo {
  text-decoration: none;
  color: var(--text-primary);
  display: inline-flex;
  align-items: center;
  gap: 12px;
}

.logo-emblem {
  width: 38px;
  height: 38px;
  object-fit: contain;
  filter: drop-shadow(0 0 10px rgba(212, 175, 55, 0.4));
  transition: transform 0.3s ease, filter 0.3s ease;
}

.logo:hover .logo-emblem {
  transform: scale(1.06) rotate(2deg);
  filter: drop-shadow(0 0 16px rgba(244, 211, 107, 0.65));
}

.logo-brand-block {
  display: flex;
  flex-direction: column;
}

.logo-text {
  font-family: var(--font-heading);
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: #ffffff;
  display: inline-flex;
  align-items: center;
  line-height: 1.1;
}

.logo-subtext {
  font-family: var(--font-body);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.16em;
  color: var(--gold-primary);
  text-transform: uppercase;
}

/* Center Nav Links */
.nav-links {
  display: flex;
  align-items: center;
  gap: 28px;
}

.nav-link {
  position: relative;
  text-decoration: none;
  font-size: 13px;
  font-weight: 500;
  color: #a8a8a8;
  letter-spacing: 0.02em;
  transition: color 0.25s ease;
  padding: 6px 0;
}

.nav-link:hover {
  color: var(--gold-bright);
}

.nav-link.active {
  color: #ffffff;
}

/* Gold active bar indicator matching Riyadvi visual identity */
.nav-link.active::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 50%;
  transform: translateX(-50%);
  width: 22px;
  height: 2px;
  background-color: var(--gold-primary);
  box-shadow: 0 0 10px var(--gold-glow);
  border-radius: 2px;
}

/* Right Nav Buttons & Actions */
.nav-actions {
  display: flex;
  align-items: center;
  gap: 14px;
}

.btn-talk {
  background: linear-gradient(135deg, #D4AF37 0%, #F4D36B 50%, #E8C875 100%);
  color: #050505;
  border: none;
  font-family: var(--font-heading);
  font-size: 12.5px;
  font-weight: 700;
  padding: 10px 22px;
  border-radius: 4px;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
  letter-spacing: 0.06em;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  text-transform: uppercase;
}

.btn-talk:hover {
  box-shadow: 0 0 24px rgba(212, 175, 55, 0.6);
  transform: translateY(-1px);
  filter: brightness(1.08);
}

/* Mobile Nav Toggle */
.mobile-nav-toggle {
  display: none;
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #ffffff;
  padding: 8px 10px;
  border-radius: 4px;
  cursor: pointer;
}

.mobile-nav-toggle span {
  display: block;
  width: 22px;
  height: 2px;
  background: #ffffff;
  margin: 4px 0;
  transition: all 0.3s ease;
}

.btn-try {
  background-color: #ffffff;
  color: #000000;
  border: none;
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 600;
  padding: 10px 24px;
  border-radius: 4px;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  letter-spacing: 0.01em;
}

.btn-try:hover {
  background-color: #f4f4f5;
  box-shadow: 0 0 20px rgba(255, 255, 255, 0.35);
  transform: translateY(-1px);
}

/* ==========================================================================
   HERO SECTION & VIDEOHERO CANVAS
   ========================================================================== */
.hero-section {
  position: relative;
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  background: radial-gradient(ellipse at 50% 40%, rgba(5, 5, 8, 0.36) 0%, rgba(5, 5, 8, 0.50) 80%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 0 clamp(24px, 5.5vw, 72px);
  margin: 0;
  z-index: 2;
}

.hero-container {
  position: relative;
  width: 100%;
  max-width: 1440px;
  height: 100vh;
  min-height: 100vh;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  pointer-events: none;
}

/* --------------------------------------------------------------------------
   HERO LAYER 1: MODERN EDITORIAL CENTERED HERO (MATCHING USER REFERENCE DESIGN)
   -------------------------------------------------------------------------- */
.hero-editorial-center {
  position: absolute;
  top: clamp(100px, 15vh, 150px);
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 1080px;
  padding: 0 24px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
  pointer-events: auto;
  user-select: text;
  transition: opacity 0.35s ease, transform 0.35s ease;
}

/* Headline */
.hero-editorial-title {
  font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: clamp(2.4rem, 5.0vw, 4.3rem);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.028em;
  color: #ffffff;
  margin: 0 0 22px 0;
  text-wrap: balance;
  text-shadow: 0 4px 24px rgba(0, 0, 0, 0.7);
}

.hero-editorial-title .hero-title-line {
  display: block;
}

.hero-serif-accent {
  font-family: 'Playfair Display', Georgia, serif;
  font-style: italic;
  font-weight: 500;
  letter-spacing: -0.01em;
  padding-left: 6px;
  padding-right: 4px;
  display: inline-block;
  background: linear-gradient(135deg, #fff9db 0%, #ffe066 22%, #f5ba13 55%, #e08704 85%, #b45309 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: #f5ba13;
  filter: drop-shadow(0 2px 20px rgba(245, 186, 19, 0.45));
}

/* Subtitle */
.hero-editorial-desc {
  max-width: 680px;
  margin: 0 auto 34px auto;
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: clamp(1rem, 1.2vw, 1.12rem);
  line-height: 1.65;
  color: #94a3b8;
  font-weight: 400;
  text-wrap: balance;
  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.9);
}

/* Bottom Action & Social Proof Bar */
.hero-editorial-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 28px;
}

/* Pill CTA Button (Exact match with reference image) */
.hero-pill-cta {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  background: #f8fafc;
  color: #090a0f;
  text-decoration: none;
  padding: 7px 8px 7px 24px;
  border-radius: 9999px;
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: -0.01em;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4px 20px rgba(255, 255, 255, 0.12), 0 2px 8px rgba(0, 0, 0, 0.4);
  cursor: pointer;
  border: 1px solid rgba(255, 255, 255, 0.8);
}

.hero-pill-cta:hover {
  background: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(255, 255, 255, 0.25), 0 4px 12px rgba(0, 0, 0, 0.5);
  color: #000000;
}

.hero-pill-arrow-wrap {
  width: 36px;
  height: 36px;
  background: #090a0f;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.25s ease, background 0.25s ease;
  flex-shrink: 0;
}

.hero-pill-cta:hover .hero-pill-arrow-wrap {
  transform: rotate(45deg);
  background: #18181b;
}

.hero-pill-arrow-wrap svg {
  width: 14px;
  height: 14px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2.2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* Social Proof Stack & Rating */
.hero-social-proof {
  display: flex;
  align-items: center;
  gap: 16px;
}

/* Overlapping Avatars */
.hero-avatar-stack {
  display: flex;
  align-items: center;
}

.hero-avatar-img {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 2px solid #08090d;
  margin-left: -10px;
  object-fit: cover;
  background: #1e293b;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  display: block;
}

.hero-avatar-img:first-child {
  margin-left: 0;
}

/* Rating */
.hero-rating-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 3px;
}

.hero-rating-stars {
  display: flex;
  align-items: center;
  gap: 3px;
  color: #f59e0b;
  font-size: 15px;
  line-height: 1;
}

.hero-rating-label {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 12.5px;
  color: #94a3b8;
  font-weight: 500;
  letter-spacing: 0.01em;
  white-space: nowrap;
}

/* Mobile Responsiveness */
@media (max-width: 768px) {
  .hero-editorial-center {
    top: clamp(90px, 14vh, 120px);
    padding: 0 20px;
  }

  .hero-editorial-title {
    font-size: clamp(2rem, 7vw, 2.7rem);
    line-height: 1.18;
    margin-bottom: 16px;
  }

  .hero-editorial-desc {
    font-size: 0.96rem;
    line-height: 1.55;
    margin-bottom: 26px;
  }

  .hero-editorial-actions {
    gap: 18px;
    flex-direction: column;
    align-items: center;
  }
}

/* --------------------------------------------------------------------------
   HERO LAYER 2: VIDEOHERO STAGE & CANVAS (GLOBAL FIXED BACKGROUND)
   -------------------------------------------------------------------------- */
.video-hero-stage {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
  transition: opacity 0.4s ease, visibility 0.4s ease;
}

.video-hero-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
  background: #050505 url('assets/HeroAbout/VideoHero_frames/frame_001.png') center center / cover no-repeat;
}

.video-hero-ambient {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 550px;
  height: 550px;
  background: radial-gradient(circle, rgba(244, 211, 107, 0.16) 0%, rgba(212, 175, 55, 0.05) 45%, transparent 70%);
  filter: blur(55px);
  border-radius: 50%;
  pointer-events: none;
  opacity: 0.7;
  transition: opacity 0.5s ease, transform 0.5s ease;
}

/* --------------------------------------------------------------------------
   ROCKET SCROLL STAGE & CANVAS (SECTIONS 3 TO 5: AWARDS, TRUST, SERVICES)
   -------------------------------------------------------------------------- */
.rocket-scroll-stage {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.35s ease, visibility 0.35s ease;
  will-change: opacity;
}

.rocket-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
  background: #000000 url('assets/rocket/ezgif-frame-001.jpg') center center / cover no-repeat;
  filter: brightness(0.96) contrast(1.04);
}

.rocket-ambient-glow {
  position: absolute;
  top: 55%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 650px;
  height: 650px;
  background: radial-gradient(circle, rgba(255, 175, 55, 0.16) 0%, rgba(212, 175, 55, 0.06) 45%, transparent 70%);
  filter: blur(60px);
  border-radius: 50%;
  pointer-events: none;
  opacity: 0.7;
  transition: opacity 0.4s ease, transform 0.4s ease;
}

.rocket-telemetry-hud {
  position: absolute;
  bottom: clamp(20px, 3vh, 36px);
  left: clamp(20px, 3.5vw, 48px);
  z-index: 12;
  display: flex;
  flex-direction: column;
  gap: 7px;
  padding: 11px 18px;
  background: rgba(10, 10, 15, 0.78);
  border: 1px solid rgba(212, 175, 55, 0.28);
  border-radius: 14px;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.75), 0 0 20px rgba(212, 175, 55, 0.12);
  pointer-events: none;
  opacity: 0.9;
  transition: opacity 0.3s ease;
}

.rocket-telemetry-hud .telemetry-badge {
  display: flex;
  align-items: center;
  gap: 8px;
}

.rocket-telemetry-hud .telemetry-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #00ffaa;
  box-shadow: 0 0 10px #00ffaa;
  animation: pulseRocketDot 1.8s infinite ease-in-out;
}

@keyframes pulseRocketDot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.85); }
}

.rocket-telemetry-hud .telemetry-phase {
  font-family: var(--font-mono, 'Space Grotesk', monospace);
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--gold-champagne, #f4d36b);
  text-transform: uppercase;
}

.rocket-telemetry-hud .telemetry-progress-line {
  width: 150px;
  height: 3px;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 2px;
  overflow: hidden;
}

.rocket-telemetry-hud .telemetry-progress-fill {
  width: 0%;
  height: 100%;
  background: linear-gradient(90deg, #d4af37 0%, #ff9e1f 60%, #ff5500 100%);
  border-radius: 2px;
  transition: width 0.08s linear;
}

.rocket-telemetry-hud .telemetry-stats {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  font-size: 9px;
  font-family: var(--font-mono, 'Space Grotesk', monospace);
  color: #9ea3b0;
  letter-spacing: 0.08em;
}

.rocket-telemetry-hud .telemetry-stat-val {
  color: #ffffff;
  font-weight: 600;
}

@media (max-width: 768px) {
  .rocket-telemetry-hud {
    display: none;
  }
}

/* --------------------------------------------------------------------------
   EARTH ORBITAL SCROLL STAGE & CANVAS (SECTIONS 6 TO 8: INDUSTRIES, GUARDIAN, PORTFOLIO)
   -------------------------------------------------------------------------- */
.earth-scroll-stage {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.35s ease, visibility 0.35s ease;
  will-change: opacity;
}

.earth-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
  background: #000000 url('assets/earth/ezgif-frame-001.png') center center / cover no-repeat;
  filter: brightness(0.95) contrast(1.05);
}

.earth-ambient-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 700px;
  height: 700px;
  background: radial-gradient(circle, rgba(97, 218, 251, 0.12) 0%, rgba(30, 144, 255, 0.05) 50%, transparent 75%);
  filter: blur(70px);
  border-radius: 50%;
  pointer-events: none;
  opacity: 0.6;
  transition: opacity 0.4s ease;
}

.earth-telemetry-hud {
  position: absolute;
  bottom: clamp(20px, 3vh, 36px);
  left: clamp(20px, 3.5vw, 48px);
  z-index: 12;
  display: flex;
  flex-direction: column;
  gap: 7px;
  padding: 11px 18px;
  background: rgba(8, 12, 18, 0.80);
  border: 1px solid rgba(97, 218, 251, 0.30);
  border-radius: 14px;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.8), 0 0 20px rgba(97, 218, 251, 0.15);
  pointer-events: none;
  opacity: 0.92;
  transition: opacity 0.3s ease;
}

.earth-telemetry-hud .telemetry-badge {
  display: flex;
  align-items: center;
  gap: 8px;
}

.earth-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #00e5ff;
  box-shadow: 0 0 10px #00e5ff;
  animation: pulseEarthDot 1.8s infinite ease-in-out;
}

@keyframes pulseEarthDot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.85); }
}

.earth-telemetry-hud .telemetry-phase {
  font-family: var(--font-mono, 'Space Grotesk', monospace);
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: #61dafb;
  text-transform: uppercase;
}

.earth-telemetry-hud .telemetry-progress-line {
  width: 150px;
  height: 3px;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 2px;
  overflow: hidden;
}

.earth-fill {
  width: 0%;
  height: 100%;
  background: linear-gradient(90deg, #00b4d8 0%, #61dafb 60%, #90e0ef 100%);
  border-radius: 2px;
  transition: width 0.08s linear;
}

