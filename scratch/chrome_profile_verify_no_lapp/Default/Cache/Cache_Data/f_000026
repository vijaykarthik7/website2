  box-shadow: 0 0 8px rgba(212, 175, 55, 0.4);
}

/* Straight Glass Card */
.milestone-card-straight {
  background: rgba(14, 14, 18, 0.85);
  border: 1px solid rgba(212, 175, 55, 0.22);
  border-radius: 14px;
  padding: 24px 28px;
  width: 100%;
  backdrop-filter: blur(12px);
  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.65);
  transition: all 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  will-change: transform, border-color, box-shadow;
}

.milestone-card-straight:hover {
  border-color: var(--gold-bright, #F4D36B);
  transform: translateX(8px);
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.85), 0 0 30px rgba(212, 175, 55, 0.22);
}

.milestone-meta-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}

.milestone-year-text {
  font-family: var(--font-heading);
  font-size: 24px;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: -0.02em;
}

.milestone-pill-badge {
  font-size: 11px;
  font-weight: 700;
  color: var(--gold-primary, #D4AF37);
  background: rgba(212, 175, 55, 0.12);
  border: 1px solid rgba(212, 175, 55, 0.3);
  padding: 3px 10px;
  border-radius: 999px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.milestone-card-title {
  font-family: var(--font-heading);
  font-size: 19px;
  font-weight: 700;
  color: var(--gold-bright, #F4D36B);
  margin-bottom: 10px;
  line-height: 1.3;
}

.milestone-card-desc {
  font-size: 14.5px;
  color: #a1a1aa;
  line-height: 1.65;
  margin: 0;
}

/* Responsive */
@media (max-width: 992px) {
  .timeline-straight-container {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .timeline-story-anchor {
    position: static;
  }

  .timeline-straight-track {
    padding-left: 42px;
  }

  .node-pin-wrap {
    left: -42px;
    width: 42px;
  }

  .milestone-card-straight {
