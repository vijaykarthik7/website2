/* ==========================================================================
   GOLD GRADIENT & UTILITIES
   ========================================================================== */
.gold-gradient {
  background: linear-gradient(135deg, #D4AF37 0%, #F4D36B 45%, #E8C875 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

.gold-border-glow {
  border: 1px solid rgba(212, 175, 55, 0.3) !important;
  box-shadow: 0 0 25px rgba(212, 175, 55, 0.15);
}

/* ==========================================================================
   PRELOADER (1-2s Premium Riyadvi Particle & Emblem Sequence)
   ========================================================================== */
.preloader {
  position: fixed;
  inset: 0;
  background: #050505;
  z-index: 99999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.7s ease;
  overflow: hidden;
}

.preloader.preloader-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.preloader-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.preloader-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.preloader-logo-wrap {
  position: relative;
  width: 90px;
  height: 90px;
  margin-bottom: 24px;
}

.preloader-logo-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 0 20px rgba(212, 175, 55, 0.65));
  animation: preloaderPulse 2s ease-in-out infinite alternate;
}

.preloader-sheen {
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);
  transform: skewX(-25deg);
  animation: preloaderSheen 1.8s ease-in-out infinite;
}

@keyframes preloaderPulse {
  0% { transform: scale(0.96); filter: drop-shadow(0 0 15px rgba(212, 175, 55, 0.4)); }
  100% { transform: scale(1.04); filter: drop-shadow(0 0 30px rgba(244, 211, 107, 0.85)); }
}

@keyframes preloaderSheen {
  0% { left: -100%; }
  60%, 100% { left: 160%; }
}

.preloader-title {
  font-family: var(--font-heading);
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.22em;
  color: #ffffff;
  margin-bottom: 6px;
  text-transform: uppercase;
}

.preloader-subtitle {
  font-family: var(--font-body);
  font-size: 11px;
  letter-spacing: 0.18em;
  color: var(--gold-primary);
  text-transform: uppercase;
}

.preloader-bar-wrap {
  width: 160px;
  height: 2px;
  background: rgba(255, 255, 255, 0.08);
  margin-top: 24px;
  border-radius: 2px;
  overflow: hidden;
}

.preloader-bar {
  width: 0%;
  height: 100%;
  background: linear-gradient(90deg, #D4AF37, #F4D36B);
  transition: width 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}

/* ==========================================================================
   CUSTOM CURSOR (Desktop Only)
   ========================================================================== */
.custom-cursor-dot {
  position: fixed;
  top: 0;
  left: 0;
  width: 8px;
  height: 8px;
  background: var(--gold-bright);
  border-radius: 50%;
  pointer-events: none;
  z-index: 99998;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 10px rgba(244, 211, 107, 0.8);
  transition: opacity 0.2s ease, transform 0.1s ease;
}

.custom-cursor-ring {
  position: fixed;
  top: 0;
  left: 0;
  width: 36px;
  height: 36px;
  border: 1.5px solid rgba(212, 175, 55, 0.45);
  border-radius: 50%;
  pointer-events: none;
  z-index: 99997;
  transform: translate(-50%, -50%);
  transition: width 0.25s ease, height 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-cursor-ring.cursor-hover {
  width: 58px;
  height: 58px;
  border-color: var(--gold-bright);
  background: rgba(212, 175, 55, 0.08);
}

.custom-cursor-label {
  font-family: var(--font-heading);
  font-size: 9px;
  font-weight: 700;
  color: var(--gold-bright);
  letter-spacing: 0.1em;
  opacity: 0;
  transition: opacity 0.2s ease;
  pointer-events: none;
}

.custom-cursor-ring.has-label .custom-cursor-label {
  opacity: 1;
}

@media (pointer: coarse), (max-width: 900px) {
  .custom-cursor-dot,
  .custom-cursor-ring {
    display: none !important;
  }
}

/* ==========================================================================
   SIGNATURE GOLDEN ENERGY LINE (Section Connector)
   ========================================================================== */
.energy-divider-wrap {
  display: none !important;
}

.energy-line-svg {
  width: 100%;
  height: 40px;
  overflow: visible;
}

.energy-line-path {
  stroke: rgba(212, 175, 55, 0.25);
  stroke-width: 1.5;
  fill: none;
}

.energy-line-pulse {
  stroke: #F4D36B;
  stroke-width: 2.5;
  stroke-dasharray: 80 400;
  fill: none;
  animation: energyFlow 5s linear infinite;
  filter: drop-shadow(0 0 8px rgba(244, 211, 107, 0.8));
}

@keyframes energyFlow {
  0% { stroke-dashoffset: 480; }
  100% { stroke-dashoffset: 0; }
}

/* ==========================================================================
   AWARDS & CREDIBILITY (Section 10)
   ========================================================================== */
.section-awards {
  position: relative;
  min-height: 850px;
  background: radial-gradient(ellipse at 50% 40%, rgba(5, 5, 8, 0.40) 0%, rgba(5, 5, 8, 0.78) 80%, rgba(3, 3, 5, 0.92) 100%);
  overflow: hidden;
  padding: 130px 0 100px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  z-index: 2;
}

/* ==========================================================================
   VOLUMETRIC STUDIO 3D STAGE & SPOTLIGHT RIG
   ========================================================================== */
.vstudio-stage {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 1;
}

/* 3D Polygonal Walls */
.vstudio-wall {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.vstudio-back-wall {
  clip-path: polygon(14% 10%, 86% 10%, 86% 75%, 14% 75%);
  background: linear-gradient(to bottom, rgba(22, 22, 26, 0.28) 0%, rgba(8, 8, 11, 0.48) 100%);
}

.vstudio-ceiling {
  clip-path: polygon(0% 0%, 100% 0%, 86% 10%, 14% 10%);
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.55) 0%, rgba(4, 4, 6, 0.35) 100%);
}

.vstudio-left-wall {
  clip-path: polygon(0% 0%, 14% 10%, 14% 75%, 0% 100%);
  background: linear-gradient(to right, rgba(8, 8, 10, 0.38) 0%, rgba(18, 18, 22, 0.26) 70%, rgba(28, 28, 32, 0.18) 100%);
}

.vstudio-right-wall {
  clip-path: polygon(100% 0%, 86% 10%, 86% 75%, 100% 100%);
  background: linear-gradient(to left, rgba(8, 8, 10, 0.38) 0%, rgba(18, 18, 22, 0.26) 70%, rgba(28, 28, 32, 0.18) 100%);
}

.vstudio-floor {
  clip-path: polygon(0% 100%, 100% 100%, 86% 75%, 14% 75%);
  background: linear-gradient(to top, rgba(16, 16, 20, 0.55) 0%, rgba(6, 6, 8, 0.35) 100%);
}

/* Wireframe Architectural Seam Lines */
.vstudio-wireframe-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
  pointer-events: none;
}

/* Ambient Wall & Floor Lighting Pools */
.vstudio-light-pools {
  position: absolute;
  inset: 0;
  z-index: 12;
  mix-blend-mode: screen;
  pointer-events: none;
  opacity: 0;
  transition: opacity 700ms cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity;
}

.vstudio-light-pools.lights-on {
  opacity: 1;
}

.vstudio-wall-pool {
  position: absolute;
  width: 20%;
  height: 38%;
  top: 14%;
  border-radius: 50%;
  transform: translateX(-50%);
  background: radial-gradient(ellipse at center, rgba(230, 240, 255, 0.16) 0%, transparent 70%);
  filter: blur(25px);
}
.vstudio-wall-pool.pool-left { left: 35%; }
.vstudio-wall-pool.pool-center { left: 50%; }
.vstudio-wall-pool.pool-right { left: 65%; }

.vstudio-floor-pool {
  position: absolute;
  width: 22%;
  height: 18%;
  bottom: 6%;
  border-radius: 50%;
  transform: translateX(-50%);
  background: radial-gradient(ellipse at center, rgba(230, 240, 255, 0.1) 0%, transparent 65%);
  filter: blur(18px);
}
.vstudio-floor-pool.floor-left { left: 35%; }
.vstudio-floor-pool.floor-center { left: 50%; }
.vstudio-floor-pool.floor-right { left: 65%; }

/* Volumetric Beams (Spotlight Shafts - Matching Reference) */
.vstudio-volumetric-beams {
  position: absolute;
  inset: 0;
  z-index: 16;
  mix-blend-mode: screen;
  pointer-events: none;
  opacity: 0;
  transition: opacity 700ms cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity;
}

.vstudio-volumetric-beams.lights-on {
  opacity: 1;
}

.vstudio-beam {
  position: absolute;
  top: 68px;
  width: 170px;
  height: 480px;
  transform: translateX(-50%);
  pointer-events: none;
  display: flex;
  justify-content: center;
}

.beam-cone {
  position: absolute;
  top: 0;
  width: 100%;
  height: 100%;
  clip-path: polygon(44% 0%, 56% 0%, 88% 100%, 12% 100%);
  background: linear-gradient(to bottom,
    rgba(255, 255, 255, 0.85) 0%,
    rgba(230, 240, 255, 0.48) 12%,
    rgba(230, 240, 255, 0.16) 30%,
    rgba(230, 240, 255, 0.04) 55%,
    transparent 80%
  );
  filter: blur(8px);
  opacity: 0.9;
}

.beam-core {
  position: absolute;
  top: 0;
  width: 48%;
  height: 75%;
  clip-path: polygon(45% 0%, 55% 0%, 75% 100%, 25% 100%);
  background: linear-gradient(to bottom,
    rgba(255, 255, 255, 0.95) 0%,
    rgba(240, 248, 255, 0.55) 10%,
    rgba(230, 240, 255, 0.14) 32%,
    transparent 65%
  );
  filter: blur(4px);
}

/* Ceiling Industrial Fixtures Track */
.vstudio-fixtures-track {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 120px;
  z-index: 31;
  pointer-events: none;
}

.vstudio-metal-rail {
  position: absolute;
  top: 24px;
  left: 0;
  width: 100%;
  height: 24px;
  background: linear-gradient(to bottom, #111 0%, #3a3a3a 30%, #666 50%, #2a2a2a 80%, #000 100%);
  box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.2), inset 0 -1px 2px rgba(0, 0, 0, 0.9), 0 10px 20px -5px rgba(0, 0, 0, 0.85);
  border-bottom: 1px solid #1a1a1a;
}

/* Industrial Spotlight Rig */
.vstudio-spot-fixture {
  position: absolute;
  top: 14px;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fixture-mount {
  width: 14px;
  height: 32px;
  border-radius: 2px;
  border: 1px solid #1a1a1a;
  background: linear-gradient(to right, #666 0%, #ffffff 40%, #999 60%, #333 100%);
  box-shadow: 0 5px 10px rgba(0, 0, 0, 0.9), inset 0 0 4px rgba(255, 255, 255, 0.5);
  position: relative;
}

.fixture-mount .mount-screw {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 5px;
  height: 5px;
  background: #111;
  border-radius: 50%;
  box-shadow: inset 0 1px 1px rgba(0, 0, 0, 1);
}
.fixture-mount .mount-screw.top { top: 4px; }
.fixture-mount .mount-screw.bottom { bottom: 4px; }

.fixture-stem {
  width: 8px;
  height: 16px;
  background: linear-gradient(to right, #1a1a1a 0%, #555 50%, #111 100%);
  border-left: 1px solid #000;
  border-right: 1px solid #000;
  position: relative;
}

.fixture-stem .stem-knob {
  position: absolute;
  bottom: -6px;
  left: 50%;
  transform: translateX(-50%);
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 1px solid #222;
  background: radial-gradient(circle at top left, #888, #111);
  box-shadow: 0 4px 8px rgba(0, 0, 0, 1), inset 0 1px 2px rgba(255, 255, 255, 0.3);
}

.fixture-housing {
  position: relative;
  margin-top: 5px;
  width: 50px;
  height: 58px;
  display: flex;
  justify-content: center;
  perspective: 400px;
}

.housing-fins {
  position: absolute;
  inset: 0;
  border-radius: 2px 2px 14px 14px;
  border: 1px solid #000;
  background: linear-gradient(to right, #111 0%, #3a3a3a 30%, #555 50%, #2a2a2a 80%, #000 100%);
  box-shadow: 0 20px 30px rgba(0, 0, 0, 0.9);
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  overflow: hidden;
}

.housing-fins span {
  width: 100%;
  height: 2px;
  background: rgba(0, 0, 0, 0.9);
  box-shadow: 0 1px 0 rgba(255, 255, 255, 0.15);
}

.housing-lens-ring {
  position: absolute;
  bottom: -6px;
  width: 52px;
  height: 16px;
  border-radius: 50%;
  border: 2px solid #1a1a1a;
  background: radial-gradient(ellipse at center, #222, #000);
  box-shadow: 0 10px 15px rgba(0, 0, 0, 1);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  overflow: hidden;
}

.housing-lens-bulb {
  width: 32px;
  height: 9px;
  border-radius: 50%;
  background: #111;
  box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.9), inset 0 -1px 1px rgba(255, 255, 255, 0.05);
  transition: all 120ms ease;
}

.housing-lens-bulb.lit {
  background: #ffffff;
  box-shadow: 0 0 20px 8px rgba(255, 255, 255, 0.95), 0 0 35px 12px rgba(230, 240, 255, 0.5), inset 0 0 8px #ffffff;
}

/* Barn Doors (Shading Flaps) */
