  font-weight: 700;
  letter-spacing: -0.02em;
  color: #ffffff;
  line-height: 1.2;
  text-shadow: 0 4px 28px rgba(0, 0, 0, 0.95);
}

.timeline-01-desc {
  font-size: 13.5px;
  color: #a1a1aa;
  line-height: 1.6;
  max-width: 560px;
  text-shadow: 0 2px 16px rgba(0, 0, 0, 0.95);
}

/* Timeline Track: Clean, borderless, transparent with zero background card */
.timeline-01-track-box {
  position: relative;
  border: none;
  padding: 50px 0;
  background: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

/* Continuous Straight Vertical Line Axis */
.timeline-01-axis {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 2px;
  pointer-events: none;
