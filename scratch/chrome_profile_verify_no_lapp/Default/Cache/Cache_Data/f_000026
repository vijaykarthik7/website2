/* ==========================================================================
   ABOUT RIYADVI & STRAIGHT VERTICAL JOURNEY TIMELINE (Sections 21 & 22)
   ========================================================================== */
.section-about.section-timeline-straight {
  position: relative;
  background: #050505;
  padding: 120px 0 60px;
  width: 100%;
