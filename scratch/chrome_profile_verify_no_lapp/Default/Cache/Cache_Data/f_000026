}

.anchor-pill {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--gold-primary, #D4AF37);
  background: rgba(212, 175, 55, 0.08);
  border: 1px solid rgba(212, 175, 55, 0.25);
  padding: 5px 12px;
  border-radius: 999px;
}

/* Right Column: Straight Vertical Timeline */
.timeline-straight-track {
  position: relative;
  padding-left: 56px;
  display: flex;
  flex-direction: column;
  gap: 36px;
}

/* Straight Vertical Golden Axis Line */
.straight-line-axis {
  position: absolute;
  left: 16px;
  top: 24px;
  bottom: 36px;
  width: 3px;
  z-index: 2;
}

.axis-line-bg {
  position: absolute;
  inset: 0;
  background: rgba(212, 175, 55, 0.2);
  border-radius: 3px;
}

.axis-line-fill {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 0%;
  background: linear-gradient(to bottom, #D4AF37, #F4D36B, #D4AF37);
  box-shadow: 0 0 16px rgba(244, 211, 107, 0.9);
  border-radius: 3px;
  transition: height 0.15s ease-out;
}

/* Straight Milestone Node */
.straight-milestone-node {
  position: relative;
  display: flex;
  align-items: flex-start;
  z-index: 3;
}

.node-pin-wrap {
  position: absolute;
  left: -56px;
  top: 22px;
  width: 56px;
  display: flex;
  align-items: center;
  pointer-events: none;
}

.node-gold-pin {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #050505;
  border: 3px solid var(--gold-primary, #D4AF37);
  box-shadow: 0 0 12px rgba(244, 211, 107, 0.5);
  flex-shrink: 0;
  z-index: 4;
  transition: all 0.35s ease;
}

.node-gold-pin.active {
  background: var(--gold-bright, #F4D36B);
  border-color: #ffffff;
  box-shadow: 0 0 22px rgba(244, 211, 107, 1);
  transform: scale(1.25);
}

.node-branch-stem {
  height: 2px;
  flex-grow: 1;
