}

.timeline-01-axis-line {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.08);
}

.timeline-01-axis-fill {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 0%;
  background: linear-gradient(180deg, #D4AF37 0%, #F4D36B 60%, #E8C875 100%);
  box-shadow: 0 0 14px rgba(244, 211, 107, 0.85);
