  border-radius: 12px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7);
}

/* Process Box Connector & Terminal Hub */
.timeline-01-process-connector {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: -48px auto 20px auto;
  z-index: 5;
}

.timeline-01-connector-stem {
  width: 2px;
  height: 24px;
  background: linear-gradient(180deg, #D4AF37 0%, #F4D36B 100%);
  box-shadow: 0 0 10px rgba(244, 211, 107, 0.7);
}

.process-terminal-pin {
  position: relative;
  left: auto;
  top: auto;
  transform: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #050505;
  border: 2px solid var(--gold-primary);
  box-shadow: 0 0 12px rgba(212, 175, 55, 0.5);
  transition: all 0.35s ease;
