/* Architectural Footer Spacer with Continuous Axis */
.timeline-01-footer-spacer {
  position: relative;
  border-left: 1px solid rgba(255, 255, 255, 0.08);
  border-right: 1px solid rgba(255, 255, 255, 0.08);
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  height: 48px;
}

.timeline-01-axis-spacer-line {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 2px;
  background: linear-gradient(180deg, #D4AF37 0%, #F4D36B 100%);
  box-shadow: 0 0 12px rgba(244, 211, 107, 0.75);
  pointer-events: none;
  z-index: 2;
}

/* 6-Step Systematic Methodology Box */
.timeline-01-process-box {
  position: relative;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: linear-gradient(180deg, rgba(12, 12, 15, 0.6) 0%, rgba(5, 5, 5, 0.9) 100%);
