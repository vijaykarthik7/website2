  background: rgba(212, 175, 55, 0.12);
  border-color: var(--gold-bright);
  color: #ffffff;
}

.estimator-footer-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

/* ==========================================================================
   CLIENT LOGOS (Section 27 — Monochrome with Color/Gold Hover)
   ========================================================================== */
.section-clients {
  position: relative;
  padding: 120px 0 130px 0;
  background: radial-gradient(ellipse at 50% 50%, rgba(5, 5, 8, 0.36) 0%, rgba(5, 5, 8, 0.72) 75%, rgba(2, 2, 4, 0.90) 100%) !important;
  border-top: 1px solid rgba(212, 175, 55, 0.12);
  border-bottom: 1px solid rgba(212, 175, 55, 0.12);
  z-index: 2;
  overflow: hidden;
  scroll-margin-top: 80px;
}

.section-clients .section-container {
  position: relative;
  z-index: 5;
}

.clients-grid {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 40px;
  margin-top: 40px;
}

.client-logo-item {
  position: relative;
  padding: 16px 24px;
  border-radius: 6px;
  transition: all 0.3s ease;
}

.client-logo-img {
  height: 42px;
  max-width: 140px;
  object-fit: contain;
  filter: grayscale(100%) opacity(0.55);
  transition: all 0.35s ease;
}

.client-logo-item:hover .client-logo-img {
  filter: grayscale(0%) opacity(1) drop-shadow(0 0 10px rgba(212, 175, 55, 0.3));
  transform: scale(1.06);
}

/* ==========================================================================
   CONTACT SECTION (Sections 29 & 30) - Luxury Dark Experience
   ========================================================================== */
.section-contact-full {
  position: relative;
  padding: 120px 0 140px 0;
  background: radial-gradient(ellipse at 50% 30%, rgba(18, 18, 26, 0.95) 0%, rgba(8, 8, 12, 0.98) 60%, #050505 100%) !important;
  border-top: 1px solid rgba(212, 175, 55, 0.12);
  z-index: 2;
  overflow: hidden;
  scroll-margin-top: 80px;
}

.section-contact-full .section-container {
  position: relative;
  z-index: 5;
}

.section-contact-full::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120px;
  background: linear-gradient(to bottom, transparent 0%, #050505 100%);
  pointer-events: none;
  z-index: 3;
}

.contact-split-grid {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 50px;
  margin-top: 50px;
}

.contact-channels-box {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.contact-channel-item {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  background: rgba(14, 14, 18, 0.85);
  border: 1px solid rgba(212, 175, 55, 0.18);
  padding: 20px;
  border-radius: 8px;
  text-decoration: none;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  transition: all 0.25s ease;
}

.contact-channel-item:hover {
  border-color: rgba(212, 175, 55, 0.5);
  background: rgba(22, 22, 28, 0.95);
  transform: translateX(4px);
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.8), 0 0 18px rgba(212, 175, 55, 0.2);
}

.channel-icon-wrap {
  width: 44px;
  height: 44px;
  border-radius: 6px;
  background: rgba(212, 175, 55, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gold-bright);
  flex-shrink: 0;
}

.channel-icon-wrap svg {
  width: 22px;
  height: 22px;
}

.channel-title {
  font-family: var(--font-heading);
  font-size: 14px;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 4px;
}

.channel-val {
  font-size: 13px;
  color: #a8a8a8;
}

.contact-lead-form {
  background: rgba(14, 14, 18, 0.88);
  border: 1px solid rgba(212, 175, 55, 0.28);
  border-radius: 12px;
  padding: 40px;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.8), 0 0 25px rgba(212, 175, 55, 0.08);
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.form-row-dual {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.lead-input,
.lead-select,
.lead-textarea {
  width: 100%;
  background: rgba(0, 0, 0, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-family: var(--font-body);
  font-size: 13.5px;
  padding: 12px 16px;
  border-radius: 4px;
  outline: none;
  transition: border-color 0.2s ease;
}

.lead-input:focus,
.lead-select:focus,
.lead-textarea:focus {
  border-color: var(--gold-bright);
}

.form-dual-buttons {
  display: flex;
  gap: 14px;
  margin-top: 10px;
}

.btn-form-primary {
  flex: 1;
  background: linear-gradient(135deg, #D4AF37 0%, #F4D36B 100%);
  color: #050505;
  border: none;
  font-family: var(--font-heading);
  font-size: 13px;
  font-weight: 700;
  padding: 13px 20px;
  border-radius: 4px;
  cursor: pointer;
  letter-spacing: 0.05em;
  transition: all 0.25s ease;
}

.btn-form-secondary {
  flex: 1;
  background: transparent;
  border: 1px solid rgba(212, 175, 55, 0.4);
  color: var(--gold-bright);
  font-family: var(--font-heading);
  font-size: 13px;
  font-weight: 700;
  padding: 13px 20px;
  border-radius: 4px;
  cursor: pointer;
  letter-spacing: 0.05em;
  transition: all 0.25s ease;
}

.btn-form-primary:hover,
.btn-form-secondary:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
}

/* ==========================================================================
   FOOTER WATERMARK & ENHANCEMENTS (Section 32)
   ========================================================================== */
.footer-watermark-wrap {
  position: absolute;
  right: 5%;
  bottom: 10%;
  pointer-events: none;
  opacity: 0.035;
  user-select: none;
}

.footer-watermark-img {
  width: 480px;
  height: 480px;
  object-fit: contain;
}

/* ==========================================================================
   FULL-SCREEN MOBILE MENU (Section 5)
   ========================================================================== */
.mobile-menu-overlay {
  position: fixed;
  inset: 0;
  background: rgba(5, 5, 5, 0.97);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  z-index: 999;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.35s ease, visibility 0.35s ease;
}

.mobile-menu-overlay.open {
  opacity: 1;
  visibility: visible;
}

.mobile-nav-links {
  display: flex;
  flex-direction: column;
  gap: 20px;
  text-align: center;
}

.mobile-nav-link {
  font-family: var(--font-heading);
  font-size: 20px;
  font-weight: 600;
  color: #ffffff;
  text-decoration: none;
  transition: color 0.2s ease;
}

.mobile-nav-link:hover {
  color: var(--gold-bright);
}

@media (max-width: 1024px) {
  .awards-grid,
  .trust-grid,
  .portfolio-grid {
    grid-template-columns: 1fr;
  }

  .process-steps-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .industry-display-box {
    max-width: 100%;
    margin: 24px auto 0 auto;
  }

  .industries-bg-robot {
    position: relative;
    top: auto;
    right: auto;
    transform: none;
    width: 100%;
    height: 440px;
    margin-top: 24px;
    -webkit-mask-image: radial-gradient(ellipse at 50% 50%, #000 45%, transparent 88%);
    mask-image: radial-gradient(ellipse at 50% 50%, #000 45%, transparent 88%);
  }

  .industry-bg-spline {
    transform: none;
  }



  .contact-split-grid {
    grid-template-columns: 1fr;
  }

  .mobile-nav-toggle {
    display: block;
  }
}

/* ==========================================================================
   LENIS SMOOTH INERTIAL SCROLL & SECTION STACKING CARD EFFECT (FROM smooth-scroll.tsx)
   ========================================================================== */
html.lenis, html.lenis body {
  height: auto;
}
.lenis.lenis-smooth {
  scroll-behavior: auto !important;
}
.lenis.lenis-smooth [data-lenis-prevent] {
  overscroll-behavior: contain;
}
.lenis.lenis-stopped {
  overflow: hidden;
}
.lenis.lenis-smooth iframe {
  pointer-events: none;
}

/* ==========================================================================
   STICKY STACKING CARD DECK ENGINE (smooth-scroll.tsx)
   ========================================================================== */

/* Awards Section: First card at the end of About Us, slides smoothly over Hero/About */
.section-awards.volumetric-studio-section {
  position: relative;
  z-index: 5;
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  border-top: 1px solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 0 50px rgba(0, 0, 0, 0.95);
  margin-top: 0;
  overflow: hidden;
  background: radial-gradient(ellipse at 50% 40%, rgba(5, 5, 8, 0.40) 0%, rgba(5, 5, 8, 0.78) 80%, rgba(3, 3, 5, 0.92) 100%) !important;
}

/* Subtle 54px Tech Grid Overlay with radial mask for Volumetric Studio Stage */
.volumetric-studio-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: 
    linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
  background-size: 54px 54px;
  mask-image: radial-gradient(ellipse 65% 50% at 50% 0%, #000 65%, transparent 100%);
  -webkit-mask-image: radial-gradient(ellipse 65% 50% at 50% 0%, #000 65%, transparent 100%);
  pointer-events: none;
  z-index: 1;
}

.volumetric-studio-section {
  background: radial-gradient(ellipse at 50% 40%, rgba(5, 5, 8, 0.40) 0%, rgba(5, 5, 8, 0.78) 80%, rgba(3, 3, 5, 0.92) 100%) !important;
}

.footer {
  position: relative;
  z-index: 20;
  background: #050505 !important;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.footer-container {
  position: relative;
  z-index: 22;
}




/* ==========================================================================
   MASTER SECTION FLOW & TRANSITION HARMONY ENGINE
   ========================================================================== */

/* 6-Step Process Completion Gateway */
.timeline-01-process-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 36px;
  gap: 12px;
}

.process-complete-badge {
  font-family: var(--font-heading);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: var(--gold-champagne);
  text-transform: uppercase;
  background: rgba(212, 175, 55, 0.08);
  border: 1px solid rgba(212, 175, 55, 0.28);
  padding: 5px 16px;
  border-radius: 999px;
  box-shadow: 0 0 16px rgba(212, 175, 55, 0.15);
}

/* Seamless Section Transitions */
.section-awards::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110px;
  background: linear-gradient(to bottom, transparent 0%, rgba(6, 6, 8, 0.65) 100%);
  pointer-events: none;
  z-index: 25;
}

/* Section Anchor Offsets for Smooth Navigation */
#about, #awards, #trust, #services, #industries, #guardian, #portfolio, #estimator, #contact {
  scroll-margin-top: 80px;
}
