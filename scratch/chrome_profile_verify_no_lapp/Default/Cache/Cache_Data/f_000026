  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  overflow: hidden;
  z-index: 1;
  opacity: 0.38;
  mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
  -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
}

.orbit-center-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 650px;
  height: 650px;
  max-width: 90vw;
  max-height: 90vw;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.22) 0%, rgba(97, 218, 251, 0.1) 35%, transparent 70%);
  filter: blur(65px);
  pointer-events: none;
}

.orbit-system-wrap {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rem;
  height: 80rem;
  max-width: 1280px;
  max-height: 1280px;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.orbit-center-hub {
  width: 64px;
  height: 64px;
  max-width: 64px;
  max-height: 64px;
  border-radius: 50%;
  background: rgba(14, 14, 18, 0.95);
  border: 2px solid rgba(97, 218, 251, 0.7);
  box-shadow: 0 0 24px rgba(97, 218, 251, 0.5), 0 0 50px rgba(212, 175, 55, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  position: relative;
}

.orbit-center-icon {
  width: 30px !important;
  height: 30px !important;
  max-width: 30px !important;
  max-height: 30px !important;
  display: block;
}

.orbit-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 1.5px dotted rgba(212, 175, 55, 0.4);
  pointer-events: none;
  will-change: transform;
}

.orbit-ring-1 {
  width: 38rem;
  height: 38rem;
  border-color: rgba(97, 218, 251, 0.45);
  animation: orbitSpin 36s linear infinite;
}

.orbit-ring-2 {
  width: 58rem;
  height: 58rem;
  border-color: rgba(212, 175, 55, 0.45);
  animation: orbitSpinRev 50s linear infinite;
}

.orbit-ring-3 {
  width: 78rem;
  height: 78rem;
  border-color: rgba(255, 255, 255, 0.35);
  animation: orbitSpin 64s linear infinite;
}

.orbit-node {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 44px;
  height: 44px;
  max-width: 44px;
  max-height: 44px;
  border-radius: 50%;
  background: rgba(16, 16, 22, 0.96);
  border: 1.5px solid rgba(255, 255, 255, 0.22);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.85), 0 0 14px rgba(212, 175, 55, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.orbit-node-inner {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.orbit-ring-1 .orbit-node-inner {
  animation: orbitCounterSpin 36s linear infinite;
}

.orbit-ring-2 .orbit-node-inner {
  animation: orbitCounterSpinRev 50s linear infinite;
}

.orbit-ring-3 .orbit-node-inner {
  animation: orbitCounterSpin 64s linear infinite;
}

.orbit-node svg {
  width: 22px !important;
  height: 22px !important;
  max-width: 22px !important;
  max-height: 22px !important;
  display: block;
}

@keyframes orbitSpin {
  from {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  to {
    transform: translate(-50%, -50%) rotate(360deg);
  }
}

@keyframes orbitSpinRev {
  from {
    transform: translate(-50%, -50%) rotate(360deg);
  }
  to {
    transform: translate(-50%, -50%) rotate(0deg);
  }
}

@keyframes orbitCounterSpin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(-360deg);
  }
}

@keyframes orbitCounterSpinRev {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

