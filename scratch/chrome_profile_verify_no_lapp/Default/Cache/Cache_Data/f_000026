  transition: transform 0.5s ease, filter 0.5s ease;
}

.timeline-01-img-card:hover .timeline-01-img {
  transform: scale(1.04);
  filter: brightness(1.08) contrast(1.08);
}

.timeline-01-img-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, transparent 0%, rgba(5, 5, 8, 0.72) 100%);
