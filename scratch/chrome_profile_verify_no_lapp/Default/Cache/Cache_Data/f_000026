}

.timeline-01-row:hover .timeline-01-node-pin,
.timeline-01-node-pin.active {
  background: var(--gold-bright);
  border-color: #ffffff;
  box-shadow: 0 0 20px rgba(244, 211, 107, 0.95);
  transform: translate(-50%, -50%) scale(1.3);
}

/* Content Side (Odd: text aligns right, Even: text aligns left) */
.timeline-01-content-side {
  width: calc(50% - 36px);
  display: flex;
  flex-direction: column;
  transition: transform 0.3s ease, opacity 0.3s ease;
}

.timeline-01-row:not(.row-even) .timeline-01-content-side {
  text-align: right;
  align-items: flex-end;
}

.timeline-01-row.row-even .timeline-01-content-side {
