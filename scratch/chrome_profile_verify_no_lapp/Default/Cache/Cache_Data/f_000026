}

.timeline-01-process-title {
  font-family: var(--font-heading);
  font-size: clamp(1.4rem, 2.2vw, 1.8rem);
  font-weight: 600;
  color: #ffffff;
  margin-top: 8px;
}

.process-steps-grid {
